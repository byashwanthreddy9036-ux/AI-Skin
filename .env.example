# Copy to .env (never commit .env). All variables are optional.

# Override project root detection (defaults to the folder containing pyproject.toml).
# SKIN_RESEARCH_ROOT=/path/to/AI-Skin

# Hugging Face token: only needed if you switch to a gated/private model.
# HF_TOKEN=

# Work fully offline once the model is cached in ./models
# HF_HUB_OFFLINE=1
